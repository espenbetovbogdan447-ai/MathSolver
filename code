    private JPanel makeForm(String[] labels, String[] defaults, JTextField[] fields) {
        JPanel form = new JPanel(new GridBagLayout());
        form.setBackground(BG);
        form.setBorder(BorderFactory.createEmptyBorder(20, 100, 20, 100));
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(6, 8, 6, 8);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        for (int i = 0; i < labels.length; i++) {
            JLabel l = new JLabel(labels[i]);
            l.setForeground(TEXT);
            l.setFont(new Font("Arial", Font.PLAIN, 15));
            gbc.gridx = 0; gbc.gridy = i; gbc.weightx = 0;
            form.add(l, gbc);

            fields[i] = makeField(defaults[i]);
            gbc.gridx = 1; gbc.weightx = 1;
            form.add(fields[i], gbc);
        }
        return form;
    }

    // Панель с кнопкой справа (не растягивается)
    private JPanel rightButtonBar(JButton btn) {
        JPanel bar = new JPanel(new FlowLayout(FlowLayout.RIGHT, 0, 0));
        bar.setBackground(BG);
        bar.setBorder(BorderFactory.createEmptyBorder(10, 0, 10, 0));
        bar.add(btn);
        return bar;
    }

    // ===== ПАНЕЛЬ ГРАФИКА =====
    static class GraphPanel extends JPanel {
        private double k = 2, b = 1;
        private final int SCALE = 30;

        GraphPanel() {
            setBackground(new Color(18, 18, 22));
            setBorder(BorderFactory.createLineBorder(new Color(60, 60, 75), 1));
        }

        void parseAndSet(String in) {
            in = in.toLowerCase().replace(" ", "").replace(',', '.');
            if (!in.contains("x")) { k = 0; b = Double.parseDouble(in); return; }
            int p = in.indexOf('x');
            String kS = in.substring(0, p);
            k = kS.isEmpty() || kS.equals("+") ? 1 : kS.equals("-") ? -1 : Double.parseDouble(kS);
            String bS = in.substring(p + 1);
            b = bS.isEmpty() ? 0 : Double.parseDouble(bS);
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            int w = getWidth(), h = getHeight();
            int cx = w / 2, cy = h / 2;

            g2.setColor(new Color(18, 18, 22));
            g2.fillRect(0, 0, w, h);

            g2.setColor(new Color(40, 40, 50));
            for (int x = cx % SCALE; x < w; x += SCALE) g2.drawLine(x, 0, x, h);
            for (int y = cy % SCALE; y < h; y += SCALE) g2.drawLine(0, y, w, y);

            g2.setColor(new Color(180, 180, 200));
            g2.setStroke(new BasicStroke(1.5f));
            g2.drawLine(0, cy, w, cy);
            g2.drawLine(cx, 0, cx, h);

            g2.drawLine(w - 10, cy - 5, w - 2, cy);
            g2.drawLine(w - 10, cy + 5, w - 2, cy);
            g2.drawLine(cx - 5, 10, cx, 2);
            g2.drawLine(cx + 5, 10, cx, 2);

            g2.setColor(new Color(200, 200, 220));
            g2.setFont(new Font("Arial", Font.BOLD, 14));
            g2.drawString("x", w - 22, cy - 10);
            g2.drawString("y", cx + 10, 20);

            g2.setFont(new Font("Arial", Font.PLAIN, 11));
            g2.setColor(new Color(140, 140, 160));
            for (int i = -20; i <= 20; i++) {
                if (i == 0) continue;
                int px = cx + i * SCALE;
                int py = cy - i * SCALE;
                if (px > 15 && px < w - 15) {
                    g2.drawLine(px, cy - 3, px, cy + 3);
                    g2.drawString(String.valueOf(i), px - 6, cy + 16);
                }
                if (py > 15 && py < h - 15) {
                    g2.drawLine(cx - 3, py, cx + 3, py);
                    g2.drawString(String.valueOf(i), cx + 8, py + 4);
                }
            }

            g2.setColor(new Color(255, 100, 100));
            g2.setStroke(new BasicStroke(2.5f));
            int x1 = cx + (int) ((-cx / (double) SCALE) * SCALE);
            int y1 = cy - (int) ((k * (-cx / (double) SCALE) + b) * SCALE);
            int x2 = cx + (int) (((w - cx) / (double) SCALE) * SCALE);
            int y2 = cy - (int) ((k * ((w - cx) / (double) SCALE) + b) * SCALE);
            g2.drawLine(x1, y1, x2, y2);

            g2.setColor(new Color(255, 200, 100));
            g2.setFont(new Font("Arial", Font.BOLD, 15));
            String label = "f(x) = " + (k == 1 ? "" : k == -1 ? "-" : Solver.fmt(k)) + "x"
                    + (b == 0 ? "" : (b > 0 ? " + " : " - ") + Solver.fmt(Math.abs(b)));
            g2.drawString(label, 20, 30);
        }
    }

