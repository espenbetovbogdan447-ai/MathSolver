    }

    private JTextArea makeOutput() {
        JTextArea a = new JTextArea();
        a.setFont(new Font("Monospaced", Font.PLAIN, 14));
        a.setEditable(false);
        a.setBackground(CARD);
        a.setForeground(OK);
        a.setCaretColor(TEXT);
        a.setLineWrap(true);
        a.setWrapStyleWord(true);
        a.setBorder(BorderFactory.createEmptyBorder(15, 15, 15, 15));
        return a;
    }

    private JTextField makeField(String def) {
        JTextField f = new JTextField(def) {
            @Override
            protected void paintComponent(Graphics g) {
                Graphics2D g2 = (Graphics2D) g.create();
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                g2.setColor(CARD);
                g2.fillRoundRect(0, 0, getWidth(), getHeight(), 10, 10);
                g2.setColor(isFocusOwner() ? ACCENT : new Color(70, 70, 85));
                g2.setStroke(new BasicStroke(1.5f));
                g2.drawRoundRect(0, 0, getWidth() - 1, getHeight() - 1, 10, 10);
                g2.dispose();
                super.paintComponent(g);
            }
        };
        f.setFont(new Font("Arial", Font.PLAIN, 16));
        f.setOpaque(false);
        f.setBorder(BorderFactory.createEmptyBorder(8, 14, 8, 14));
        f.setForeground(TEXT);
