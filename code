                g2.dispose();
                super.paintComponent(g);
            }
        };
        display.setFont(new Font("Arial", Font.BOLD, 30));
        display.setHorizontalAlignment(JTextField.RIGHT);
        display.setEditable(false);
        display.setOpaque(false);
        display.setForeground(TEXT);
        display.setBorder(BorderFactory.createEmptyBorder(15, 20, 15, 20));

        JPanel buttons = new JPanel(new GridLayout(5, 4, 8, 8));
        buttons.setBackground(BG);
        String[] keys = {
                "C", "(", ")", "÷",
                "7", "8", "9", "×",
                "4", "5", "6", "−",
                "1", "2", "3", "+",
                "0", ".", "=", "√"
        };
        final StringBuilder expr = new StringBuilder();

        for (String k : keys) {
            JButton b = new JButton(k);
            b.setFont(new Font("Arial", Font.BOLD, 22));
            b.setOpaque(false);
            b.setContentAreaFilled(false);
            b.setBorderPainted(false);
            b.setFocusPainted(false);
            b.setForeground(k.equals("=") ? new Color(15, 15, 20) : TEXT);
            final Color bgColor = k.equals("=") ? ACCENT : CARD;
            b.setBackground(bgColor);
            b.addActionListener(e -> {
                String key = b.getText();
                if (key.equals("C")) expr.setLength(0);
                else if (key.equals("=")) {
                    try {
                        double r = eval(expr.toString());
                        display.setText(String.valueOf(r));
                        expr.setLength(0);
                        expr.append(r);
                        return;
                    } catch (Exception ex) {
                        display.setText("Ошибка");
                        expr.setLength(0);
                        return;
                    }
                } else if (key.equals("√")) {
                    try {
                        double v = eval(expr.toString());
                        display.setText(String.valueOf(Math.sqrt(v)));
                        expr.setLength(0);
                        return;
                    } catch (Exception ex) {
                        display.setText("Ошибка");
                        expr.setLength(0);
                        return;
                    }
                } else expr.append(key);
                display.setText(expr.toString());
            });
            b.setUI(new javax.swing.plaf.basic.BasicButtonUI() {
                @Override
                public void paint(Graphics g, JComponent c) {
                    Graphics2D g2 = (Graphics2D) g.create();
                    g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                    AbstractButton ab = (AbstractButton) c;
                    g2.setColor(ab.getModel().isRollover() ?
                            (k.equals("=") ? new Color(120, 190, 255) : CARD_HOVER) : bgColor);
                    g2.fillRoundRect(0, 0, c.getWidth(), c.getHeight(), 12, 12);
                    g2.dispose();
                    super.paint(g, c);
                }
            });
            buttons.add(b);
        }

        JPanel center = new JPanel(new BorderLayout(0, 15));
        center.setBackground(BG);
        center.setBorder(BorderFactory.createEmptyBorder(20, 150, 20, 150));
        center.add(display, BorderLayout.NORTH);
        center.add(buttons, BorderLayout.CENTER);

        p.add(center, BorderLayout.CENTER);
        switchTo(p);
    }

    private double eval(String s) {
        s = s.replace("×", "*").replace("÷", "/").replace("−", "-");
        final String str = s;
        return new Object() {
            int pos = -1, ch;
            void next() { ch = (++pos < str.length()) ? str.charAt(pos) : -1; }
            boolean eat(int c) { while (ch == ' ') next(); if (ch == c) { next(); return true; } return false; }
            double parse() { next(); double x = e(); if (pos < str.length()) throw new RuntimeException("Символ: " + (char) ch); return x; }
            double e() { double x = t(); for (;;) { if (eat('+')) x += t(); else if (eat('-')) x -= t(); else return x; } }
            double t() { double x = f(); for (;;) { if (eat('*')) x *= f(); else if (eat('/')) x /= f(); else return x; } }
            double f() {
                if (eat('+')) return f();
                if (eat('-')) return -f();
                double x; int start = pos;
                if (eat('(')) { x = e(); eat(')'); }
                else if ((ch >= '0' && ch <= '9') || ch == '.') {
                    while ((ch >= '0' && ch <= '9') || ch == '.') next();
                    x = Double.parseDouble(str.substring(start, pos));
                } else throw new RuntimeException("Символ: " + (char) ch);
                return x;
            }
        }.parse();
    }

