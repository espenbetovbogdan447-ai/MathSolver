        root.add(grid, BorderLayout.CENTER);
        switchTo(root);
    }

    // ===== ЛИНЕЙНЫЕ СИСТЕМЫ =====
    private void showLinear() {
        JPanel p = screenWithBack("Системы линейных уравнений");

        JTextArea input = new JTextArea(6, 40);
        input.setFont(new Font("Monospaced", Font.PLAIN, 15));
        input.setBackground(CARD);
        input.setForeground(TEXT);
        input.setCaretColor(TEXT);
        input.setBorder(BorderFactory.createEmptyBorder(12, 12, 12, 12));
        input.setText("2 1 1 5\n4 -6 0 -2\n1 1 1 20,5");

        JTextArea output = makeOutput();
        JButton solve = makeAccentButton("Решить");

        solve.addActionListener(e -> {
            try {
                String[] lines = input.getText().trim().split("\n");
                int n = lines.length;
                double[][] m = new double[n][n + 1];
                for (int i = 0; i < n; i++) {
                    String[] q = lines[i].trim().split("\\s+");
                    if (q.length != n + 1) throw new Exception("В строке " + (i + 1) + " нужно " + (n + 1) + " чисел");
                    for (int j = 0; j <= n; j++) m[i][j] = Solver.parseNum(q[j]);
                }
                double[][] r = Solver.gaussJordan(m);
                StringBuilder sb = new StringBuilder("Решение:\n\n");
                String[] v = {"a", "b", "c", "d", "e"};
                for (int i = 0; i < n; i++) sb.append(v[i]).append(" = ").append(String.format("%.4f", r[i][n])).append("\n");
                output.setText(sb.toString());
            } catch (Exception ex) { output.setText("❌ " + ex.getMessage()); }
        });

        JLabel hint = new JLabel("Введите строки: коэффициенты + свободный член (запятая ок!)");
        hint.setForeground(MUTED);
        hint.setBorder(BorderFactory.createEmptyBorder(0, 0, 6, 0));

        JPanel inputPanel = new JPanel(new BorderLayout(0, 6));
        inputPanel.setBackground(BG);
        inputPanel.add(hint, BorderLayout.NORTH);
        inputPanel.add(scroll(input), BorderLayout.CENTER);

        // Кнопка справа, не растягивается
        JPanel buttonBar = new JPanel(new FlowLayout(FlowLayout.RIGHT, 0, 0));
        buttonBar.setBackground(BG);
        buttonBar.setBorder(BorderFactory.createEmptyBorder(10, 0, 10, 0));
        buttonBar.add(solve);

        JPanel content = new JPanel(new BorderLayout(0, 0));
        content.setBackground(BG);
        content.add(inputPanel, BorderLayout.NORTH);
        content.add(buttonBar, BorderLayout.CENTER);
        content.add(scroll(output), BorderLayout.SOUTH);

        p.add(content, BorderLayout.CENTER);
        switchTo(p);
    }

    // ===== КВАДРАТНЫЕ =====
    private void showQuad() {
        JPanel p = screenWithBack("ax² + bx + c = 0");
        JTextField[] f = new JTextField[3];
        JPanel form = makeForm(new String[]{"a =", "b =", "c ="}, new String[]{"1", "-3", "2"}, f);
        JTextArea out = makeOutput();

        JButton solve = makeAccentButton("Решить");
        solve.addActionListener(e -> {
            try {
                double a = Solver.parseNum(f[0].getText()), b = Solver.parseNum(f[1].getText()), c = Solver.parseNum(f[2].getText());
                if (a == 0) { out.setText("a = 0: x = " + (-c / b)); return; }
                double D = b * b - 4 * a * c;
                StringBuilder sb = new StringBuilder("D = " + Solver.fmt(D) + "\n\n");
                if (D > 0) {
                    sb.append("x₁ = ").append((-b + Math.sqrt(D)) / (2 * a)).append("\n");
                    sb.append("x₂ = ").append((-b - Math.sqrt(D)) / (2 * a));
                } else if (D == 0) sb.append("x = ").append(-b / (2 * a));
                else sb.append("Комплексные: x = ").append(-b / (2 * a)).append(" ± ").append(Math.sqrt(-D) / (2 * a)).append("i");
                out.setText(sb.toString());
            } catch (Exception ex) { out.setText("❌ " + ex.getMessage()); }
        });

        JPanel content = new JPanel(new BorderLayout(0, 10));
        content.setBackground(BG);
        content.add(form, BorderLayout.NORTH);
        content.add(rightButtonBar(solve), BorderLayout.CENTER);
        content.add(scroll(out), BorderLayout.SOUTH);

        p.add(content, BorderLayout.CENTER);
        switchTo(p);
    }

